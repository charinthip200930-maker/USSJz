SpeedBox.FocusLost:Connect(function()
    local val = tonumber(SpeedBox.Text)
    if val then
        if val > 1000 then val = 1000 end
        if val < 1 then val = 1 end
        TargetSpeed = val
        SpeedBox.Text = tostring(val)
    else
        SpeedBox.Text = tostring(TargetSpeed)
    end
end)

-- ระบบบังคับความเร็วตลอดเวลา (บังคับเขียนทับทุกเฟรม)
RunService.Stepped:Connect(function()
    if LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.WalkSpeed ~= TargetSpeed then
            humanoid.WalkSpeed = TargetSpeed
        end
    end
end)

-- ตรวจจับเมื่อตัวละครเกิดใหม่ ให้ใส่ค่าความเร็วเดิมทันที
